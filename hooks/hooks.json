{
  "description": "Opens a live preview window when Claude writes or edits a plan-shaped markdown file.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/plan-preview.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
